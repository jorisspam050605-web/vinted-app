generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PricingMode {
  MULTIPLIER
  FIXED
}

enum NicheStatus {
  ACTIVE
  PAUSED
}

enum Condition {
  NEUF_AVEC_ETIQUETTE
  NEUF_SANS_ETIQUETTE
  TRES_BON_ETAT
  BON_ETAT
  SATISFAISANT
}

enum OpportunityStatus {
  NOUVELLE
  IGNOREE
  ACHETEE
  REVENDUE
  NON_RENTABLE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  webhookToken String   @unique @default(cuid()) // utilise pour /api/webhooks/watcher et le bookmarklet
  createdAt    DateTime @default(now())

  niches        Niche[]
  opportunities Opportunity[]
  settings      Settings?
}

model Niche {
  id                String        @id @default(cuid())
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  name              String
  brands            String
  category          String
  keywords          String
  size              String
  minCondition      Condition
  pricingMode       PricingMode
  maxBuyPrice       Float
  targetResalePrice Float?
  targetMultiplier  Float?
  status            NicheStatus   @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  opportunities     Opportunity[]

  @@index([userId])
}

model Opportunity {
  id                  String            @id @default(cuid())
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  niche               Niche             @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  nicheId             String
  title               String
  brand               String?
  price               Float
  size                String?
  condition           String?
  photoUrl            String?
  listingUrl          String
  publishedAt         DateTime?
  source              String            @default("manuel")
  estimatedResale     Float
  estimatedMargin     Float
  estimatedMultiplier Float
  realSalePrice       Float?
  status              OpportunityStatus @default(NOUVELLE)
  detectedAt          DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([userId])
  @@index([nicheId])
}

model Settings {
  id                 String   @id @default(cuid())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String   @unique
  packagingFee       Float    @default(0)
  platformFeePercent Float    @default(0)
  miscFee            Float    @default(0)
  notifyApp          Boolean  @default(true)
  notifyEmail        Boolean  @default(false)
  notifyTelegram     Boolean  @default(false)
  notifyDiscord      Boolean  @default(false)
  notifyEmailTo      String?
  telegramChatId     String?
  discordWebhookUrl  String?
  updatedAt          DateTime @updatedAt
}
